DEBUG=True
PROJECT_ENVIRONMENT=local
SECRET_KEY=replace-with-a-generated-django-secret
DJANGO_JWT_SIGNING_KEY=replace-with-a-generated-django-jwt-signing-key
LANGUAGE_CODE=en-us
TIME_ZONE=UTC
ALLOWED_HOSTS=127.0.0.1,localhost

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_DB_SSL_REQUIRE=True
SUPABASE_HTTP_TIMEOUT=10

# Supabase Storage
SUPABASE_STORAGE_BUCKET=media
SUPABASE_STORAGE_BASE_PATH=
SUPABASE_STORAGE_PUBLIC=False
SUPABASE_STORAGE_SIGNED_URL_EXPIRY=3600

# Optional local fallback if you need to boot Django before Supabase DB credentials exist
# DATABASE_URL=sqlite:///db.sqlite3

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_HTTPONLY=True

# Redis / Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Optional extras
SENTRY_DSN=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com

# Google Maps
GOOGLE_MAPS_SERVER_KEY=your-google-maps-server-key

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
